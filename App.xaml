<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinThunar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinThunar">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Window surfaces, which SystemColorsTheme recolors in place so Mica shows through. They repeat
                 SystemControlBackgroundAltHighBrush as literals: a StaticResource alias here resolves once,
                 against the Windows theme. WinUI keys the dark dictionary "Default". Re-check the colors on
                 Windows App SDK upgrades; see CONTRIBUTING.md. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WinThunarBackdropBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="WinThunarLayerBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WinThunarBackdropBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="WinThunarLayerBrush" Color="#FF000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WinThunarBackdropBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="WinThunarLayerBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </Style>
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemControlErrorTextForegroundBrush}" />
            </Style>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
