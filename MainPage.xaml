<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinThunar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:WinThunar.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Key="FileContextMenu" Opened="FileContextMenu_Opened">
            <MenuFlyoutItem x:Name="RestoreMenuItem" Text="Restore" Click="RestoreFromTrash_Click" Visibility="Collapsed" />
            <MenuFlyoutItem x:Name="ContextOpenMenuItem" Text="Open" Click="Open_Click" />
            <MenuFlyoutItem x:Name="ContextOpenWithMenuItem" Text="Open With..." Click="OpenWith_Click" />
            <MenuFlyoutItem x:Name="ContextOpenInNewTabMenuItem" Text="Open in New Tab" Click="OpenInNewTab_Click" />
            <MenuFlyoutItem x:Name="ContextOpenInNewWindowMenuItem" Text="Open in New Window" Click="OpenSelectedInNewWindow_Click" />
            <MenuFlyoutItem x:Name="ContextOpenTerminalMenuItem" Text="Open Terminal Here" Click="OpenSelectedTerminal_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ContextCutMenuItem" Text="Cut" Click="Cut_Click" />
            <MenuFlyoutItem x:Name="ContextCopyMenuItem" Text="Copy" Click="Copy_Click" />
            <MenuFlyoutItem x:Name="ContextPasteIntoMenuItem" Text="Paste Into Folder" Click="PasteIntoSelectedFolder_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ContextDuplicateMenuItem" Text="Duplicate" Click="Duplicate_Click" />
            <MenuFlyoutItem x:Name="ContextRenameMenuItem" Text="Rename" Click="Rename_Click" />
            <MenuFlyoutItem x:Name="ContextMakeLinkMenuItem" Text="Make Link" Click="MakeLink_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ContextMoveToTrashMenuItem" Text="Move to Trash" Click="MoveToTrash_Click" />
            <MenuFlyoutItem x:Name="ContextDeletePermanentlyMenuItem" Text="Delete Permanently" Click="DeletePermanently_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ContextShowMoreOptionsMenuItem" Text="Show More Options" Click="ShowMoreItemOptions_Click" />
            <MenuFlyoutItem Text="Properties" Click="Properties_Click" />
        </MenuFlyout>
        <MenuFlyout x:Key="FolderContextMenu" Opened="FolderContextMenu_Opened">
            <MenuFlyoutItem x:Name="FolderCreateFolderMenuItem" Text="Create Folder..." Click="CreateFolder_Click" />
            <MenuFlyoutSubItem x:Name="FolderCreateDocumentMenu" Text="Create Document" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="FolderPasteMenuItem" Text="Paste" Click="Paste_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="View">
                <MenuFlyoutItem Text="Icon View" Click="IconView_Click" />
                <MenuFlyoutItem Text="Detailed List" Click="DetailsView_Click" />
                <MenuFlyoutItem Text="Compact List" Click="CompactView_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="Sort By">
                <MenuFlyoutItem Text="Name" Click="SortName_Click" />
                <MenuFlyoutItem Text="Size" Click="SortSize_Click" />
                <MenuFlyoutItem Text="Type" Click="SortType_Click" />
                <MenuFlyoutItem Text="Date Modified" Click="SortModified_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSubItem Text="Zoom">
                <MenuFlyoutItem Text="Zoom In" Click="ZoomIn_Click" />
                <MenuFlyoutItem Text="Zoom Out" Click="ZoomOut_Click" />
                <MenuFlyoutItem Text="Normal Size" Click="ZoomNormal_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem Text="Custom Actions..." Click="CustomActions_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="FolderShowMoreOptionsMenuItem" Text="Show More Options" Click="ShowMoreFolderOptions_Click" />
            <MenuFlyoutItem Text="Properties" Click="Properties_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
            <MenuBarItem x:Name="FileMenuBarItem" Title="File" AccessKey="F" PointerEntered="FileMenu_PointerEntered" GettingFocus="FileMenu_GettingFocus" AccessKeyInvoked="FileMenu_AccessKeyInvoked">
                <MenuFlyoutItem x:Name="FileOpenMenuItem" Text="Open" Click="Open_Click" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="FileOpenWithMenuItem" Text="Open With..." Click="OpenWith_Click" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="FileOpenInNewTabMenuItem" Text="Open in New Tab" Click="OpenInNewTab_Click" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="FileOpenInNewWindowMenuItem" Text="Open in New Window" Click="OpenSelectedInNewWindow_Click" Visibility="Collapsed" />
                <MenuFlyoutItem x:Name="FileOpenTerminalMenuItem" Text="Open Terminal Here" Click="OpenSelectedTerminal_Click" Visibility="Collapsed" />
                <MenuFlyoutSeparator x:Name="FileSelectionSeparator" Visibility="Collapsed" />
                <MenuFlyoutItem Text="New Tab" Click="NewTab_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Close Tab" Click="CloseTab_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="New Window" Click="NewWindow_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FileCreateFolderMenuItem" Text="Create Folder..." Click="CreateFolder_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="FileCreateDocumentMenu" Text="Create Document" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FilePropertiesMenuItem" Text="Properties" Click="Properties_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Modifiers="Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FileEmptyTrashMenuItem" Text="Empty Trash..." Click="EmptyTrash_Click" />
            </MenuBarItem>
            <MenuBarItem x:Name="EditMenuBarItem" Title="Edit" AccessKey="E" PointerEntered="EditMenu_PointerEntered" GettingFocus="EditMenu_GettingFocus" AccessKeyInvoked="EditMenu_AccessKeyInvoked">
                <MenuFlyoutItem x:Name="UndoMenuItem" Text="Undo" Click="Undo_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RedoMenuItem" Text="Redo" Click="Redo_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="EditCutMenuItem" Text="Cut" Click="Cut_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="X" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="EditCopyMenuItem" Text="Copy" Click="Copy_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="EditPasteMenuItem" Text="Paste" Click="Paste_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="EditMoveToTrashMenuItem" Text="Move to Trash" Click="MoveToTrash_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="EditDeletePermanentlyMenuItem" Text="Delete Permanently" Click="DeletePermanently_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" Modifiers="Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="EditDuplicateMenuItem" Text="Duplicate" Click="Duplicate_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="EditRenameMenuItem" Text="Rename" Click="Rename_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Select All" Click="SelectAll_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Select by Pattern..." Click="SelectPattern_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Invert Selection" Click="InvertSelection_Click" />
                <MenuFlyoutItem Text="Preferences" Click="Preferences_Click" />
                <MenuFlyoutItem Text="Keyboard Shortcuts..." Click="KeyboardShortcuts_Click" />
                <MenuFlyoutItem Text="Custom Actions..." Click="CustomActions_Click" />
                <MenuFlyoutItem Text="Plugins..." Click="Plugins_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Reload" Click="Refresh_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="ShowHiddenMenuItem" Text="Show Hidden Files" Click="ShowHiddenFiles_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="H" Modifiers="Control" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem x:Name="IconViewMenuItem" Text="Icon View" GroupName="ViewMode" Click="IconView_Click">
                    <RadioMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                    </RadioMenuFlyoutItem.KeyboardAccelerators>
                </RadioMenuFlyoutItem>
                <RadioMenuFlyoutItem x:Name="DetailsViewMenuItem" Text="Detailed List" GroupName="ViewMode" Click="DetailsView_Click" IsChecked="True">
                    <RadioMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number2" Modifiers="Control" />
                    </RadioMenuFlyoutItem.KeyboardAccelerators>
                </RadioMenuFlyoutItem>
                <RadioMenuFlyoutItem x:Name="CompactViewMenuItem" Text="Compact List" GroupName="ViewMode" Click="CompactView_Click">
                    <RadioMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number3" Modifiers="Control" />
                    </RadioMenuFlyoutItem.KeyboardAccelerators>
                </RadioMenuFlyoutItem>
                <MenuFlyoutSubItem Text="Sort By">
                    <RadioMenuFlyoutItem x:Name="SortNameMenuItem" Text="Name" GroupName="SortColumn" Click="SortName_Click" />
                    <RadioMenuFlyoutItem x:Name="SortSizeMenuItem" Text="Size" GroupName="SortColumn" Click="SortSize_Click" />
                    <RadioMenuFlyoutItem x:Name="SortTypeMenuItem" Text="Type" GroupName="SortColumn" Click="SortType_Click" />
                    <RadioMenuFlyoutItem x:Name="SortModifiedMenuItem" Text="Date Modified" GroupName="SortColumn" Click="SortModified_Click" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="SortDescendingMenuItem" Text="Descending" Click="SortDescending_Click" />
                    <ToggleMenuFlyoutItem x:Name="FoldersFirstMenuItem" Text="Folders First" Click="FoldersFirst_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Zoom">
                    <MenuFlyoutItem Text="Zoom In" Click="ZoomIn_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Add" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Zoom Out" Click="ZoomOut_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Subtract" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Normal Size" Click="ZoomNormal_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number0" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="ShowThumbnailsMenuItem" Text="Show Thumbnails" Click="ShowThumbnails_Click" />
                <MenuFlyoutItem Text="Configure Columns..." Click="ConfigureColumns_Click" />
                <MenuFlyoutItem Text="Configure Toolbar..." Click="ConfigureToolbar_Click" />
                <ToggleMenuFlyoutItem x:Name="ImagePreviewMenuItem" Text="Preview Pane" Click="ImagePreview_Click" />
                <ToggleMenuFlyoutItem x:Name="TerminalPanelMenuItem" Text="Terminal Panel" Click="TerminalPanel_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F4" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSubItem Text="Side Pane">
                    <RadioMenuFlyoutItem x:Name="ShortcutsPaneMenuItem" Text="Shortcuts" GroupName="SidePane" Click="ShortcutsPane_Click" />
                    <RadioMenuFlyoutItem x:Name="TreePaneMenuItem" Text="Tree" GroupName="SidePane" Click="TreePane_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Location Selector">
                    <RadioMenuFlyoutItem x:Name="LocationEntryMenuItem" Text="Toolbar Style" GroupName="LocationSelector" Click="LocationEntry_Click" />
                    <RadioMenuFlyoutItem x:Name="PathBarMenuItem" Text="Pathbar Style" GroupName="LocationSelector" Click="PathBar_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="SplitViewMenuItem" Text="Split View" Click="SplitView_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Go" AccessKey="G">
                <MenuFlyoutItem Text="Back" Click="Back_Click" />
                <MenuFlyoutItem Text="Forward" Click="Forward_Click" />
                <MenuFlyoutItem Text="Open Parent" Click="Up_Click" />
                <MenuFlyoutItem Text="Home" Click="Home_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Network" Click="OpenNetwork_Click" />
                <MenuFlyoutItem Text="Connect to Server..." Click="ConnectToServer_Click" />
                <MenuFlyoutItem Text="Open Terminal Here" Click="OpenTerminal_Click" />
                <MenuFlyoutItem Text="Eject Removable Drive..." Click="EjectDrive_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Bookmarks" AccessKey="B">
                <MenuFlyoutItem Text="Add Current Folder" Click="AddBookmark_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Remove Current Folder" Click="RemoveBookmark_Click" />
                <MenuFlyoutItem Text="Rename Current Bookmark..." Click="RenameBookmark_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Move Current Bookmark Up" Click="MoveBookmarkUp_Click" />
                <MenuFlyoutItem Text="Move Current Bookmark Down" Click="MoveBookmarkDown_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="Interrupted Transfers..." Click="InterruptedTransfers_Click" />
                <MenuFlyoutItem Text="Check for Updates..." Click="CheckForUpdates_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About WinThunar" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1" Padding="6,4" Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
            <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackToolbarButton" AutomationProperties.Name="Back" Tag="Back" Click="Back_Click" ContextRequested="NavigationButton_ContextRequested" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <Button x:Name="ForwardToolbarButton" AutomationProperties.Name="Forward" Tag="Forward" Click="Forward_Click" ContextRequested="NavigationButton_ContextRequested" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72A;" FontSize="16" />
                        <TextBlock Text="Forward" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpToolbarButton" AutomationProperties.Name="Up" Tag="Up" Click="Up_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74A;" FontSize="16" />
                        <TextBlock Text="Up" />
                    </StackPanel>
                </Button>
                <Button x:Name="HomeToolbarButton" AutomationProperties.Name="Home" Tag="Home" Click="Home_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                        <TextBlock Text="Home" />
                    </StackPanel>
                </Button>
                <Border x:Name="ToolbarSeparator" Width="1" Margin="6,3" Background="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" />
                <Button x:Name="ReloadToolbarButton" AutomationProperties.Name="Reload" Tag="Reload" Click="Refresh_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Reload" />
                    </StackPanel>
                </Button>
                <Button x:Name="SearchToolbarButton" AutomationProperties.Name="Search" Tag="Search" Click="Search_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Padding="8,4,8,8" ColumnSpacing="6" Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LocationLabel" Text="Location:" VerticalAlignment="Center" />
            <TextBox
                x:Name="LocationBox" AutomationProperties.Name="Folder location"
                Grid.Column="1"
                Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                KeyDown="LocationBox_KeyDown" />
            <ScrollViewer
                x:Name="PathBarScroller"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <StackPanel x:Name="PathBarPanel" Orientation="Horizontal" Spacing="2" />
            </ScrollViewer>
            <Button x:Name="LocationGoButton" AutomationProperties.Name="Open entered folder" Grid.Column="2" Content="Go" Click="Go_Click" />
            <Button x:Name="PathBarEditButton" AutomationProperties.Name="Edit folder location" Grid.Column="2" Content="Edit" Click="PathBarEdit_Click" Visibility="Collapsed" />
            <TextBlock x:Name="SearchLabel" Text="Search:" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBox
                x:Name="SearchBox" AutomationProperties.Name="Search files"
                Grid.Column="1"
                PlaceholderText="Search names or use content:&quot;a phrase&quot; type:txt"
                ToolTipService.ToolTip="Combine name:&quot;annual report&quot; type:pdf modified:last7days size:&gt;1MB. content:&quot;a phrase&quot; reads supported text files up to 16 MiB. Add index:true to query the Windows index, including indexed document contents; unindexed items are omitted. Wildcards: *.txt."
                AutomationProperties.HelpText="Search names or combine name, type, modified date, size, and content filters. Add index:true to use Windows indexing; unindexed items are omitted."
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown"
                Visibility="Collapsed" />
            <Button x:Name="CloseSearchButton" AutomationProperties.Name="Close search" Grid.Column="2" Content="Close" Click="CloseSearch_Click" Visibility="Collapsed" />
        </Grid>

        <TabView
            x:Name="BrowserTabs" AutomationProperties.Name="Folder tabs"
            Grid.Row="3"
            Height="38"
            AllowDrop="True"
            DragEnter="FileList_DragEnter"
            DragOver="FileList_DragEnter"
            DragLeave="FileList_DragLeave"
            Drop="FileList_Drop"
            IsAddTabButtonVisible="True"
            AddTabButtonClick="BrowserTabs_AddTabButtonClick"
            SelectionChanged="BrowserTabs_SelectionChanged"
            TabCloseRequested="BrowserTabs_TabCloseRequested" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="160" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
            <ScrollViewer x:Name="ShortcutsSidePane" Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
                <StackPanel Padding="6,8">
                    <TextBlock Text="DEVICES" Margin="8,6,8,4" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    <ListView x:Name="DevicesList" AutomationProperties.Name="Devices" ItemsSource="{x:Bind ViewModel.Devices}" IsItemClickEnabled="True" ItemClick="Location_ItemClick" SelectionMode="None"
                              AllowDrop="True" DragEnter="FileList_DragEnter" DragOver="FileList_DragEnter" DragLeave="FileList_DragLeave" Drop="FileList_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationLocation">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                    <Grid Width="20" Height="22" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}" Stretch="Uniform" />
                                        <FontIcon Glyph="{x:Bind Glyph}" Visibility="{Binding GlyphVisibility}" FontSize="16" />
                                        <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" CornerRadius="3"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="12" Padding="1,0"
                                            Visibility="{Binding GitVisibility}" ToolTipService.ToolTip="{Binding GitDescription}">
                                            <TextBlock Text="{Binding GitBadge}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="BOOKMARKS" Margin="8,16,8,4" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    <ListView x:Name="BookmarksList" AutomationProperties.Name="Bookmarks" ItemsSource="{x:Bind ViewModel.Bookmarks}" IsItemClickEnabled="True" ItemClick="Location_ItemClick" SelectionMode="None"
                              AllowDrop="True" DragEnter="FileList_DragEnter" DragOver="FileList_DragEnter" DragLeave="FileList_DragLeave" Drop="FileList_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationLocation">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                    <FontIcon Glyph="{x:Bind Glyph}" Width="20" Height="22" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="PLACES" Margin="8,16,8,4" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    <ListView x:Name="PlacesList" AutomationProperties.Name="Places" ItemsSource="{x:Bind ViewModel.Places}" IsItemClickEnabled="True" ItemClick="Location_ItemClick" SelectionMode="None"
                              AllowDrop="True" DragEnter="FileList_DragEnter" DragOver="FileList_DragEnter" DragLeave="FileList_DragLeave" Drop="FileList_Drop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationLocation">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                    <FontIcon Glyph="{x:Bind Glyph}" Width="20" Height="22" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" />
                                </StackPanel>
