<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinThunar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:WinThunar.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFF5F5F5"
    Loaded="Page_Loaded"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Key="FileContextMenu" Opened="FileContextMenu_Opened">
            <MenuFlyoutItem Text="Open" Click="Open_Click" />
            <MenuFlyoutItem Text="Open With..." Click="OpenWith_Click" />
            <MenuFlyoutItem Text="Open in New Tab" Click="OpenInNewTab_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Cut" Click="Cut_Click" />
            <MenuFlyoutItem Text="Copy" Click="Copy_Click" />
            <MenuFlyoutItem Text="Paste" Click="Paste_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Duplicate" Click="Duplicate_Click" />
            <MenuFlyoutItem Text="Rename" Click="Rename_Click" />
            <MenuFlyoutItem Text="Make Link" Click="MakeLink_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Move to Trash" Click="MoveToTrash_Click" />
            <MenuFlyoutItem Text="Delete Permanently" Click="DeletePermanently_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Properties" Click="Properties_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Background="#FFECECEC">
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem Text="New Tab" Click="NewTab_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Close Tab" Click="CloseTab_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="New Window" Click="NewWindow_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Create Folder" Click="CreateFolder_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Create Document" Click="CreateDocument_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Properties" Click="Properties_Click" />
                <MenuFlyoutItem Text="Empty Trash..." Click="EmptyTrash_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Edit" AccessKey="E">
                <MenuFlyoutItem x:Name="UndoMenuItem" Text="Undo" Click="Undo_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RedoMenuItem" Text="Redo" Click="Redo_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Cut" Click="Cut_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="X" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy" Click="Copy_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Paste" Click="Paste_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Move to Trash" Click="MoveToTrash_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Delete Permanently" Click="DeletePermanently_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" Modifiers="Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Duplicate" Click="Duplicate_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Rename" Click="Rename_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Select All" Click="SelectAll_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Select by Pattern..." Click="SelectPattern_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Invert Selection" Click="InvertSelection_Click" />
                <MenuFlyoutItem Text="Preferences" Click="Preferences_Click" />
                <MenuFlyoutItem Text="Keyboard Shortcuts..." Click="KeyboardShortcuts_Click" />
                <MenuFlyoutItem Text="Custom Actions..." Click="CustomActions_Click" />
                <MenuFlyoutItem Text="Plugins..." Click="Plugins_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Reload" Click="Refresh_Click" />
                <ToggleMenuFlyoutItem x:Name="ShowHiddenMenuItem" Text="Show Hidden Files" Click="ShowHiddenFiles_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="H" Modifiers="Control" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem x:Name="IconViewMenuItem" Text="Icon View" GroupName="ViewMode" Click="IconView_Click">
                    <RadioMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                    </RadioMenuFlyoutItem.KeyboardAccelerators>
                </RadioMenuFlyoutItem>
                <RadioMenuFlyoutItem x:Name="DetailsViewMenuItem" Text="Detailed List" GroupName="ViewMode" Click="DetailsView_Click" IsChecked="True">
                    <RadioMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number2" Modifiers="Control" />
                    </RadioMenuFlyoutItem.KeyboardAccelerators>
                </RadioMenuFlyoutItem>
                <RadioMenuFlyoutItem x:Name="CompactViewMenuItem" Text="Compact List" GroupName="ViewMode" Click="CompactView_Click">
                    <RadioMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number3" Modifiers="Control" />
                    </RadioMenuFlyoutItem.KeyboardAccelerators>
                </RadioMenuFlyoutItem>
                <MenuFlyoutSubItem Text="Sort By">
                    <RadioMenuFlyoutItem x:Name="SortNameMenuItem" Text="Name" GroupName="SortColumn" Click="SortName_Click" />
                    <RadioMenuFlyoutItem x:Name="SortSizeMenuItem" Text="Size" GroupName="SortColumn" Click="SortSize_Click" />
                    <RadioMenuFlyoutItem x:Name="SortTypeMenuItem" Text="Type" GroupName="SortColumn" Click="SortType_Click" />
                    <RadioMenuFlyoutItem x:Name="SortModifiedMenuItem" Text="Date Modified" GroupName="SortColumn" Click="SortModified_Click" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="SortDescendingMenuItem" Text="Descending" Click="SortDescending_Click" />
                    <ToggleMenuFlyoutItem x:Name="FoldersFirstMenuItem" Text="Folders First" Click="FoldersFirst_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Zoom">
                    <MenuFlyoutItem Text="Zoom In" Click="ZoomIn_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Add" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Zoom Out" Click="ZoomOut_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Subtract" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Normal Size" Click="ZoomNormal_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number0" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="ShowThumbnailsMenuItem" Text="Show Thumbnails" Click="ShowThumbnails_Click" />
                <MenuFlyoutItem Text="Configure Columns..." Click="ConfigureColumns_Click" />
                <MenuFlyoutItem Text="Configure Toolbar..." Click="ConfigureToolbar_Click" />
                <ToggleMenuFlyoutItem x:Name="ImagePreviewMenuItem" Text="Image Preview" Click="ImagePreview_Click" />
                <ToggleMenuFlyoutItem x:Name="TerminalPanelMenuItem" Text="Terminal Panel" Click="TerminalPanel_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F4" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <MenuFlyoutSubItem Text="Side Pane">
                    <RadioMenuFlyoutItem x:Name="ShortcutsPaneMenuItem" Text="Shortcuts" GroupName="SidePane" Click="ShortcutsPane_Click" />
                    <RadioMenuFlyoutItem x:Name="TreePaneMenuItem" Text="Tree" GroupName="SidePane" Click="TreePane_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Location Selector">
                    <RadioMenuFlyoutItem x:Name="LocationEntryMenuItem" Text="Toolbar Style" GroupName="LocationSelector" Click="LocationEntry_Click" />
                    <RadioMenuFlyoutItem x:Name="PathBarMenuItem" Text="Pathbar Style" GroupName="LocationSelector" Click="PathBar_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="SplitViewMenuItem" Text="Split View" Click="SplitView_Click">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Go" AccessKey="G">
                <MenuFlyoutItem Text="Back" Click="Back_Click" />
                <MenuFlyoutItem Text="Forward" Click="Forward_Click" />
                <MenuFlyoutItem Text="Open Parent" Click="Up_Click" />
                <MenuFlyoutItem Text="Home" Click="Home_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Network" Click="OpenNetwork_Click" />
                <MenuFlyoutItem Text="Connect to Server..." Click="ConnectToServer_Click" />
                <MenuFlyoutItem Text="Open Terminal Here" Click="OpenTerminal_Click" />
                <MenuFlyoutItem Text="Eject Removable Drive..." Click="EjectDrive_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Bookmarks" AccessKey="B">
                <MenuFlyoutItem Text="Add Current Folder" Click="AddBookmark_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Remove Current Folder" Click="RemoveBookmark_Click" />
                <MenuFlyoutItem Text="Rename Current Bookmark..." Click="RenameBookmark_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Move Current Bookmark Up" Click="MoveBookmarkUp_Click" />
                <MenuFlyoutItem Text="Move Current Bookmark Down" Click="MoveBookmarkDown_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="About WinThunar" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1" Padding="6,4" Background="#FFF5F5F5">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackToolbarButton" Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <Button x:Name="ForwardToolbarButton" Click="Forward_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72A;" FontSize="16" />
                        <TextBlock Text="Forward" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpToolbarButton" Click="Up_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74A;" FontSize="16" />
                        <TextBlock Text="Up" />
                    </StackPanel>
                </Button>
                <Button x:Name="HomeToolbarButton" Click="Home_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                        <TextBlock Text="Home" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="6,3" Background="#FFD0D0D0" />
                <Button x:Name="ReloadToolbarButton" Click="Refresh_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock Text="Reload" />
                    </StackPanel>
                </Button>
                <Button x:Name="SearchToolbarButton" Click="Search_Click" Background="Transparent" BorderThickness="0" Padding="8,5">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Padding="8,4,8,8" ColumnSpacing="6" Background="#FFF5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LocationLabel" Text="Location:" VerticalAlignment="Center" />
            <TextBox
                x:Name="LocationBox"
                Grid.Column="1"
                Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                KeyDown="LocationBox_KeyDown" />
            <ScrollViewer
                x:Name="PathBarScroller"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <StackPanel x:Name="PathBarPanel" Orientation="Horizontal" Spacing="2" />
            </ScrollViewer>
            <Button x:Name="LocationGoButton" Grid.Column="2" Content="Go" Click="Go_Click" />
            <Button x:Name="PathBarEditButton" Grid.Column="2" Content="Edit" Click="PathBarEdit_Click" Visibility="Collapsed" />
            <TextBlock x:Name="SearchLabel" Text="Search:" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText="Search this folder and its subfolders"
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown"
                Visibility="Collapsed" />
            <Button x:Name="CloseSearchButton" Grid.Column="2" Content="Close" Click="CloseSearch_Click" Visibility="Collapsed" />
        </Grid>

        <TabView
            x:Name="BrowserTabs"
            Grid.Row="3"
            Height="38"
            IsAddTabButtonVisible="True"
            AddTabButtonClick="BrowserTabs_AddTabButtonClick"
            SelectionChanged="BrowserTabs_SelectionChanged"
            TabCloseRequested="BrowserTabs_TabCloseRequested" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="160" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Background="#FFE9E9E9">
            <ScrollViewer x:Name="ShortcutsSidePane" Background="#FFE9E9E9">
                <StackPanel Padding="6,8">
                    <TextBlock Text="DEVICES" Margin="8,6,8,4" FontSize="12" FontWeight="SemiBold" Foreground="#FF555555" />
                    <ListView ItemsSource="{x:Bind ViewModel.Devices}" IsItemClickEnabled="True" ItemClick="Location_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationLocation">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                    <Grid Width="20" Height="22" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}" Stretch="Uniform" />
                                        <FontIcon Glyph="{x:Bind Glyph}" Visibility="{Binding GlyphVisibility}" FontSize="16" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="BOOKMARKS" Margin="8,16,8,4" FontSize="12" FontWeight="SemiBold" Foreground="#FF555555" />
                    <ListView ItemsSource="{x:Bind ViewModel.Bookmarks}" IsItemClickEnabled="True" ItemClick="Location_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationLocation">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                    <FontIcon Glyph="{x:Bind Glyph}" Width="20" Height="22" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="PLACES" Margin="8,16,8,4" FontSize="12" FontWeight="SemiBold" Foreground="#FF555555" />
                    <ListView ItemsSource="{x:Bind ViewModel.Places}" IsItemClickEnabled="True" ItemClick="Location_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationLocation">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                    <FontIcon Glyph="{x:Bind Glyph}" Width="20" Height="22" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="NETWORK" Margin="8,16,8,4" FontSize="12" FontWeight="SemiBold" Foreground="#FF555555" />
                    <ListView ItemsSource="{x:Bind ViewModel.NetworkLocations}" IsItemClickEnabled="True" ItemClick="Location_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationLocation">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                    <FontIcon Glyph="{x:Bind Glyph}" Width="20" Height="22" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
            <TreeView
                x:Name="DirectoryTree"
                Visibility="Collapsed"
                Expanding="DirectoryTree_Expanding"
                ItemInvoked="DirectoryTree_ItemInvoked" />
            </Grid>

            <Border Grid.Column="1" Background="#FFD0D0D0" />

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SplitDividerColumn" Width="0" />
                    <ColumnDefinition x:Name="SecondaryPaneColumn" Width="0" />
                    <ColumnDefinition x:Name="ImagePreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="PrimaryPaneBorder"
                    Grid.Column="0"
                    BorderBrush="#FF5B9BD5"
                    BorderThickness="0"
                    PointerPressed="PrimaryPane_PointerPressed">
                <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Visibility="{x:Bind ViewModel.DetailsViewVisibility, Mode=OneWay}" Padding="12,0" Background="#FFF0F0F0" BorderBrush="#FFD4D4D4" BorderThickness="0,0,0,1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SizeColumn" Width="110" />
                        <ColumnDefinition x:Name="TypeColumn" Width="140" />
                        <ColumnDefinition x:Name="ModifiedColumn" Width="160" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="SortName_Click"><TextBlock Text="Name" FontWeight="SemiBold" /></Button>
                    <Button Grid.Column="1" Padding="0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="SortSize_Click"><TextBlock Text="Size" FontWeight="SemiBold" /></Button>
                    <Button Grid.Column="2" Padding="0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="SortType_Click"><TextBlock Text="Type" FontWeight="SemiBold" /></Button>
                    <Button Grid.Column="3" Padding="0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="SortModified_Click"><TextBlock Text="Date Modified" FontWeight="SemiBold" /></Button>
                </Grid>

                <ListView
                    x:Name="FileList"
                    Grid.Row="1"
                    Visibility="{x:Bind ViewModel.DetailsViewVisibility, Mode=OneWay}"
                    AllowDrop="True"
                    DragEnter="FileList_DragEnter"
                    DragOver="FileList_DragEnter"
                    Drop="FileList_Drop"
                    ItemsSource="{x:Bind ViewModel.Entries}"
                    ContextFlyout="{StaticResource FileContextMenu}"
                    IsDoubleTapEnabled="True"
                    IsItemClickEnabled="True"
                    ItemClick="FileList_ItemClick"
                    IsMultiSelectCheckBoxEnabled="False"
                    DoubleTapped="FileList_DoubleTapped"
                    SelectionChanged="FileList_SelectionChanged"
                    SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="8,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileSystemEntry">
                            <Grid ColumnSpacing="8" CanDrag="True" DragStarting="FileRow_DragStarting" ToolTipService.ToolTip="{x:Bind FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{x:Bind SizeColumnWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind TypeColumnWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind ModifiedColumnWidth, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" Width="20" Height="22" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Size}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Modified}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <GridView
                    x:Name="IconFileList"
                    Grid.RowSpan="2"
                    Visibility="{x:Bind ViewModel.IconViewVisibility, Mode=OneWay}"
                    AllowDrop="True"
                    DragEnter="FileList_DragEnter"
                    DragOver="FileList_DragEnter"
                    Drop="FileList_Drop"
                    ItemsSource="{x:Bind ViewModel.Entries}"
                    ContextFlyout="{StaticResource FileContextMenu}"
                    IsDoubleTapEnabled="True"
                    IsItemClickEnabled="True"
                    ItemClick="FileList_ItemClick"
                    DoubleTapped="FileList_DoubleTapped"
                    IsMultiSelectCheckBoxEnabled="False"
                    SelectionChanged="FileList_SelectionChanged"
                    SelectionMode="Extended">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="144" ItemHeight="120" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileSystemEntry">
                            <Grid Width="{x:Bind IconItemWidth, Mode=OneWay}" Height="{x:Bind IconItemHeight, Mode=OneWay}" CanDrag="True" DragStarting="FileRow_DragStarting" ToolTipService.ToolTip="{x:Bind FullPath}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <Grid Width="{x:Bind IconImageSize, Mode=OneWay}" Height="{x:Bind IconImageSize, Mode=OneWay}" HorizontalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}" Stretch="Uniform" />
                                        <FontIcon Glyph="{x:Bind Glyph}" Visibility="{Binding GlyphVisibility}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                     <TextBlock Text="{x:Bind Name}" Width="{x:Bind IconNameWidth, Mode=OneWay}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <GridView
                    x:Name="CompactFileList"
                    Grid.RowSpan="2"
                    Visibility="{x:Bind ViewModel.CompactViewVisibility, Mode=OneWay}"
                    AllowDrop="True"
                    DragEnter="FileList_DragEnter"
                    DragOver="FileList_DragEnter"
                    Drop="FileList_Drop"
                    ItemsSource="{x:Bind ViewModel.Entries}"
                    ContextFlyout="{StaticResource FileContextMenu}"
                    IsDoubleTapEnabled="True"
                    IsItemClickEnabled="True"
                    ItemClick="FileList_ItemClick"
                    DoubleTapped="FileList_DoubleTapped"
                    IsMultiSelectCheckBoxEnabled="False"
                    SelectionChanged="FileList_SelectionChanged"
                    SelectionMode="Extended">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Vertical" ItemWidth="240" ItemHeight="36" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileSystemEntry">
                            <Grid Width="232" Height="36" CanDrag="True" DragStarting="FileRow_DragStarting" ToolTipService.ToolTip="{x:Bind FullPath}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Grid Width="20" Height="24" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}" Stretch="Uniform" />
                                        <FontIcon Glyph="{x:Bind Glyph}" Visibility="{Binding GlyphVisibility}" FontSize="16" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" Width="196" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ProgressRing
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>
                </Border>

                <Border
                    x:Name="SplitDivider"
                    Grid.Column="1"
                    Width="5"
                    Background="#FFD0D0D0"
                    Visibility="Collapsed" />

                <Border
                    x:Name="SecondaryPaneBorder"
                    Grid.Column="2"
                    BorderBrush="#FF5B9BD5"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    PointerPressed="SecondaryPane_PointerPressed">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="6,4" ColumnSpacing="4" Background="#FFF5F5F5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Padding="7,3" Content="&#x2190;" Click="SplitBack_Click" ToolTipService.ToolTip="Back" />
                            <Button Grid.Column="1" Padding="7,3" Content="&#x2191;" Click="SplitUp_Click" ToolTipService.ToolTip="Up" />
                            <Button Grid.Column="2" Padding="7,3" Content="&#x2302;" Click="SplitHome_Click" ToolTipService.ToolTip="Home" />
                            <TextBox
                                x:Name="SplitLocationBox"
                                Grid.Column="3"
                                Text="{x:Bind SplitViewModel.CurrentPath, Mode=OneWay}"
                                KeyDown="SplitLocationBox_KeyDown" />
                            <Button Grid.Column="4" Content="Go" Click="SplitGo_Click" />
                        </Grid>

                        <Grid Grid.Row="1" Padding="10,0" Background="#FFF0F0F0" BorderBrush="#FFD4D4D4" BorderThickness="0,0,0,1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Size" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Type" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>

                        <ListView
                            x:Name="SecondaryFileList"
                            Grid.Row="2"
                            AllowDrop="True"
                            DragEnter="FileList_DragEnter"
                            DragOver="FileList_DragEnter"
                            Drop="FileList_Drop"
                            ItemsSource="{x:Bind SplitViewModel.Entries}"
                            ContextFlyout="{StaticResource FileContextMenu}"
                            IsDoubleTapEnabled="True"
                            IsItemClickEnabled="True"
                            ItemClick="FileList_ItemClick"
                            IsMultiSelectCheckBoxEnabled="False"
                            DoubleTapped="FileList_DoubleTapped"
                            SelectionChanged="FileList_SelectionChanged"
                            SelectionMode="Extended">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="8,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileSystemEntry">
                                    <Grid ColumnSpacing="6" CanDrag="True" DragStarting="FileRow_DragStarting" ToolTipService.ToolTip="{x:Bind FullPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Grid Width="20" Height="22" VerticalAlignment="Center">
                                                <Image Source="{Binding Thumbnail}" Visibility="{Binding ThumbnailVisibility}" Stretch="Uniform" />
                                                <FontIcon Glyph="{x:Bind Glyph}" Visibility="{Binding GlyphVisibility}" FontSize="16" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Size}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ProgressRing
                            Grid.RowSpan="3"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind SplitViewModel.IsBusy, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border
                    x:Name="ImagePreviewPane"
                    Grid.Column="3"
                    Padding="12"
                    Background="#FFF7F7F7"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="IMAGE PREVIEW" FontSize="12" FontWeight="SemiBold" Foreground="#FF555555" />
                        <Image x:Name="PreviewImage" Height="220" Stretch="Uniform" />
                        <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewMetadata" FontSize="12" Foreground="#FF555555" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewPath" FontSize="11" Foreground="#FF666666" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border
            x:Name="TerminalPane"
            Grid.Row="4"
            Height="230"
            Margin="212,0,0,0"
            Padding="8"
            VerticalAlignment="Bottom"
            Background="#FF202020"
            BorderBrush="#FF555555"
            BorderThickness="1,1,0,0"
            Visibility="Collapsed">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TerminalPathLabel" Foreground="White" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Close" Click="CloseTerminalPanel_Click" />
                </Grid>
                <TextBox
                    x:Name="TerminalOutput"
                    Grid.Row="1"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="Consolas"
                    Background="#FF101010"
                    Foreground="#FFF2F2F2"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Grid Grid.Row="2" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PS&gt;" Foreground="White" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBox x:Name="TerminalCommand" Grid.Column="1" FontFamily="Consolas" KeyDown="TerminalCommand_KeyDown" />
                    <Button Grid.Column="2" Content="Run" Click="RunTerminalCommand_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="5"
            Padding="10,7"
            Background="#FFF5F5F5"
            BorderBrush="#FFD0D0D0"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind ViewModel.TransferPanelVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind ViewModel.ActiveTransferTitle, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveTransferDetail, Mode=OneWay}" FontSize="12" Foreground="#FF555555" />
                    <ProgressBar
                        Height="4"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ActiveTransferProgress, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.QueuedTransferText, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Foreground="#FF555555" />
                <Button Grid.Column="2" Content="Cancel" Click="CancelTransfer_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="6" Padding="8,5" Background="#FFECECEC" BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </Border>
    </Grid>
</Page>
