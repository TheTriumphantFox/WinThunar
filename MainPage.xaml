                Severity="Informational"
                IsOpen="False"
                CloseButtonClick="UpdateInfoBar_CloseButtonClick">
                <InfoBar.ActionButton>
                    <Button x:Name="RestartToUpdateButton" Content="Restart Now" Click="RestartToUpdate_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Border Padding="8,5" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusAnnouncement" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
